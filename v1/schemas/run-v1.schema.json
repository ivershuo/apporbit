{
  "$id": "urn:apporbit:schema:run:v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "collectorVersion": {
      "type": "string",
      "minLength": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetKey": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "object",
            "properties": {
              "store": {
                "type": "string",
                "enum": [
                  "apple",
                  "google-play"
                ]
              },
              "market": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "marketTimeZone": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "pattern": "^[a-z]{2}$"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "apps",
                  "games"
                ]
              },
              "chart": {
                "type": "string",
                "enum": [
                  "top-free",
                  "top-paid",
                  "top-grossing"
                ]
              },
              "normalizedCategory": {
                "type": "string",
                "minLength": 1
              },
              "storeCategory": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expectedCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "publicationMode": {
                "type": "string",
                "enum": [
                  "probe",
                  "publish"
                ]
              }
            },
            "required": [
              "store",
              "market",
              "language",
              "scope",
              "chart",
              "normalizedCategory",
              "storeCategory",
              "expectedCount",
              "publicationMode"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "not_attempted",
              "valid",
              "partial",
              "failed",
              "quarantined",
              "unsupported"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "attempts": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "snapshotPath": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "message"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "targetKey",
          "target",
          "status",
          "startedAt",
          "finishedAt",
          "attempts",
          "snapshotPath",
          "error",
          "flags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "collectorVersion",
    "startedAt",
    "finishedAt",
    "targets"
  ],
  "additionalProperties": false
}
