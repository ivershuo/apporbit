{
  "$id": "urn:apporbit:schema:snapshot:v1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "store": {
      "type": "string",
      "enum": [
        "apple",
        "google-play"
      ]
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "apps",
        "games"
      ]
    },
    "chart": {
      "type": "string",
      "enum": [
        "top-free",
        "top-paid",
        "top-grossing"
      ]
    },
    "normalizedCategory": {
      "type": "string",
      "minLength": 1
    },
    "storeCategory": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "observationDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "marketTimeZone": {
      "type": "string",
      "minLength": 1
    },
    "marketObservationDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "partial"
      ]
    },
    "expectedCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "actualCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "apple-rss",
            "google-play-scraper"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "collectorVersion": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "type",
        "method",
        "url",
        "collectorVersion",
        "adapterVersion",
        "payloadSha256"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "previousSnapshotId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "previousSnapshotId",
        "flags"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "appId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "rank",
          "appId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "store",
    "market",
    "scope",
    "chart",
    "normalizedCategory",
    "storeCategory",
    "capturedAt",
    "observationDate",
    "status",
    "expectedCount",
    "actualCount",
    "complete",
    "source",
    "validation",
    "entries"
  ],
  "additionalProperties": false
}
